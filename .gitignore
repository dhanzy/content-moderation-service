# Local environment overrides. Auto-loaded by app/config.py, so never committed:
# .env.example is the template that is.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# uv resolves from the committed uv.lock; the local env is not shared.
# uv.lock itself IS committed on purpose -- it is the dependency lockfile.

# Node
node_modules/
dist/

# Local evidence output from the load harness; regenerated by `make evidence`.
evidence/*.json
!evidence/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
