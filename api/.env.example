# Copy to api/.env to run the services on the host without exporting anything:
#
#   cp api/.env.example api/.env
#
# app/config.py loads api/.env automatically with override=False, so anything
# already set in the real environment wins. Under Docker Compose every value
# below arrives from docker-compose.yml, and this file is not copied into the
# image, so it has no effect there.
#
# Every line is commented out: the defaults in app/config.py already match a
# stack started with `docker compose up -d db redis`. Uncomment only what you
# need to change.

# --- infrastructure -------------------------------------------------------
# Host addresses. These match the ports docker-compose.yml publishes.
# DATABASE_URL=postgresql+asyncpg://mod:mod@localhost:5432/moderation
# REDIS_URL=redis://localhost:6379/0

# --- the fake provider ----------------------------------------------------
# PROVIDER_URL=http://localhost:8001
#
# Must be identical for the api and the provider, or every callback is rejected
# with a 401 and long videos stay pending.
# PROVIDER_SECRET=dev-provider-secret
#
# Note: CALLBACK_URL is deliberately NOT here. It belongs to the provider, which
# is a separate project and does not read this file. Pass it when starting the
# provider on the host:
#   cd provider && CALLBACK_URL=http://localhost:8000/provider/callback uv run main.py

# --- behaviour ------------------------------------------------------------
# "broken" reproduces the Tuesday incident on purpose. See README.
# SCREENING_MODE=fixed
# MAX_ATTEMPTS=5
# LEASE_SECONDS=30
# WORKER_CONCURRENCY=4
# PROVIDER_TIMEOUT_S=5.0
# LOG_LEVEL=INFO

# --- fault injection (tests and demos only) -------------------------------
# Makes GET /review fail, to exercise loading vs failed vs empty in the UI.
# REVIEW_FAIL=1
#
# A media ID, or *, to kill the worker after the provider has scored an item
# but before the result is saved.
# CRASH_AFTER_SCORE=
